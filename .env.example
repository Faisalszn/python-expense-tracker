DATABASE_URL=postgresql://username:password@localhost:5432/expense_tracker
SECRET_KEY=change-me

# Optional. Leave unset for local development.
# FLASK_DEBUG=1        # 1 = show interactive debugger and auto-reload (default), 0 = off
# FLASK_ENV=production # set to "production" once served over HTTPS to require secure cookies

# Used only by the test suite (tests/conftest.py), never by the app itself.
# Point this at a separate database — running the tests truncates its tables.
# TEST_DATABASE_URL=postgresql://username:password@localhost:5432/expense_tracker_test
